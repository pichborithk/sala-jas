type Album {
    id: String
    title: String!

    tracks: [AlbumTrack!]
    artists: [AlbumArtist!]
    production: AlbumProduction
}

type AlbumTrack {
    id: String
    title: String!
    audioUrl: String
    downloadUrl: String
    coverUrl: String
    artist: String
    artists: [AlbumArtist!]
}

type AlbumArtist {
    id: String
    name: String!
}

type AlbumProduction {
    id: String
    name: String!
}

extend type Query {
    getAlbumById(id: String!): Album
}

